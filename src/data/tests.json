[
  {
    "id": "lesson-1",
    "number": 1,
    "title": "1-Dars: Kasrlarni qo'shish va ayirish",
    "description": "Oddiy kasrlar, aralash sonlar va umumiy maxrajga keltirish orqali qo'shish va ayirish amallari",
    "durationMinutes": 30,
    "createdAt": "2026-11-05T10:00:00.000Z",
    "questions": [
      {
        "id": "k1-1",
        "text": "Hisoblang: 3/7 + 2/7",
        "options": ["5/7", "5/14", "6/7", "1/7"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nMaxrajlari bir xil kasrlar qo'shilganda suratlari qo'shiladi va umumiy maxraj o'zgarmasdan saqlanadi:\n3/7 + 2/7 = (3 + 2) / 7 = 5/7"
      },
      {
        "id": "k1-2",
        "text": "Hisoblang: 9/13 - 4/13",
        "options": ["5/13", "5/0", "13/13", "3/13"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nMaxrajlari bir xil kasrlar ayirilganda birinchi kasr suratidan ikkinchisiniki ayiriladi:\n9/13 - 4/13 = (9 - 4) / 13 = 5/13"
      },
      {
        "id": "k1-3",
        "text": "Hisoblang: 1/2 + 1/3",
        "options": ["5/6", "2/5", "1/6", "5/5"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n2 va 3 sonlari uchun EKUK(2, 3) = 6 bo'ladi. Har bir kasrni umumiy maxraj 6 ga keltiramiz:\n1/2 = 3/6 va 1/3 = 2/6\n3/6 + 2/6 = (3 + 2) / 6 = 5/6"
      },
      {
        "id": "k1-4",
        "text": "Hisoblang: 3/4 - 1/6",
        "options": ["7/12", "2/2", "1/12", "5/12"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n4 va 6 uchun eng kichik umumiy maxraj 12 ga teng:\n3/4 = 9/12 va 1/6 = 2/12\n9/12 - 2/12 = (9 - 2) / 12 = 7/12"
      },
      {
        "id": "k1-5",
        "text": "Hisoblang: 2/5 + 3/10",
        "options": ["7/10", "5/15", "1/2", "4/5"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nUmumiy maxraj 10:\n2/5 = 4/10\n4/10 + 3/10 = 7/10"
      },
      {
        "id": "k1-6",
        "text": "Hisoblang: 1 - 5/8",
        "options": ["3/8", "5/8", "1/8", "7/8"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n1 butunni 8/8 ko'rinishida yozib olamiz:\n8/8 - 5/8 = (8 - 5) / 8 = 3/8"
      },
      {
        "id": "k1-7",
        "text": "Hisoblang: 2 1/3 + 1 1/2",
        "options": ["3 5/6", "3 2/5", "4 1/6", "3 1/6"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nButun qismlarni alohida, kasr qismlarni alohida qo'shamiz:\n2 + 1 = 3\n1/3 + 1/2 = 2/6 + 3/6 = 5/6\nNatija: 3 butun 5/6 (yoki 23/6)"
      },
      {
        "id": "k1-8",
        "text": "Hisoblang: 4 1/4 - 1 3/4",
        "options": ["2 1/2", "3 1/2", "2 3/4", "3"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nNoto'g'ri kasrga aylantiramiz:\n4 1/4 = 17/4, 1 3/4 = 7/4\n17/4 - 7/4 = 10/4 = 5/2 = 2 1/2"
      },
      {
        "id": "k1-9",
        "text": "Hisoblang: 5 - 2 3/7",
        "options": ["2 4/7", "3 4/7", "2 3/7", "3 3/7"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n5 dan 1 butunni maydalaymiz: 5 = 4 7/7\n4 7/7 - 2 3/7 = (4 - 2) + (7/7 - 3/7) = 2 4/7"
      },
      {
        "id": "k1-10",
        "text": "Hisoblang: 7/15 + 4/9",
        "options": ["41/45", "11/24", "43/45", "37/45"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nEKUK(15, 9) = 45:\n7/15 = 21/45 va 4/9 = 20/45\n21/45 + 20/45 = 41/45"
      },
      {
        "id": "k1-11",
        "text": "Hisoblang: 11/12 - 5/8",
        "options": ["7/24", "6/4", "1/4", "5/24"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nEKUK(12, 8) = 24:\n11/12 = 22/24 va 5/8 = 15/24\n22/24 - 15/24 = 7/24"
      },
      {
        "id": "k1-12",
        "text": "Amalni bajaring: 5/6 - 1/3 + 1/2",
        "options": ["1", "2/3", "4/6", "5/6"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nUmumiy maxraj 6:\n5/6 - 2/6 + 3/6 = (5 - 2 + 3) / 6 = 6/6 = 1"
      },
      {
        "id": "k1-13",
        "text": "Tenglamani yeching: x + 1/4 = 7/8",
        "options": ["5/8", "3/8", "6/8", "1/2"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nx = 7/8 - 1/4 = 7/8 - 2/8 = 5/8"
      },
      {
        "id": "k1-14",
        "text": "Tenglamani yeching: 5/6 - x = 1/2",
        "options": ["1/3", "1/6", "2/3", "1/4"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nx = 5/6 - 1/2 = 5/6 - 3/6 = 2/6 = 1/3"
      },
      {
        "id": "k1-15",
        "text": "Hisoblang: 0.5 + 1/4",
        "options": ["3/4 (yoki 0.75)", "1/2", "0.6", "4/5"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n0.5 = 1/2 = 2/4\n2/4 + 1/4 = 3/4 = 0.75"
      },
      {
        "id": "k1-16",
        "text": "Hisoblang: 1.2 - 3/5",
        "options": ["0.6", "0.5", "0.7", "0.4"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n3/5 kasrni o'nli kasrga aylantiramiz: 3/5 = 0.6\n1.2 - 0.6 = 0.6"
      },
      {
        "id": "k1-17",
        "text": "Hisoblang: 3 2/5 + 4 1/3",
        "options": ["7 11/15", "7 3/8", "7 2/15", "8 1/15"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nButun qismlar: 3 + 4 = 7\nKasr qismlar: 2/5 + 1/3 = 6/15 + 5/15 = 11/15\nNatija: 7 11/15"
      },
      {
        "id": "k1-18",
        "text": "Hisoblang: 6 1/6 - 2 5/12",
        "options": ["3 3/4", "3 7/12", "4 1/4", "3 5/12"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\n6 1/6 = 6 2/12 = 5 14/12\n5 14/12 - 2 5/12 = 3 9/12 = 3 3/4"
      },
      {
        "id": "k1-19",
        "text": "Uchta kasrning yig'indisini toping: 1/2 + 1/4 + 1/8",
        "options": ["7/8", "3/8", "5/8", "1"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nUmumiy maxraj 8:\n4/8 + 2/8 + 1/8 = (4 + 2 + 1) / 8 = 7/8"
      },
      {
        "id": "k1-20",
        "text": "Hisoblang: 17/20 - (1/4 + 2/5)",
        "options": ["1/5", "1/4", "3/20", "1/10"],
        "correctOptionIndex": 0,
        "explanation": "Yechilishi:\nQavs ichi: 1/4 + 2/5 = 5/20 + 8/20 = 13/20\n17/20 - 13/20 = 4/20 = 1/5"
      }
    ]
  },
  {
